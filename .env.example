# ═══════════════════════════════════════════════════════════════════
# Self-Healing SRE Agent — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════
# SECURITY: Copy to .env and fill values. NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════

# ── Neo4j Bi-Temporal Graph ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=selfhealing

# ── E2B Sandbox ──
E2B_API_KEY=
E2B_SANDBOX_TIMEOUT_MS=30000

# ── FastAPI Brain ──
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8000
BRAIN_LOG_LEVEL=info
BRAIN_CORS_ORIGINS=["http://localhost:3000"]

# ── LLM Reasoning Engine ──
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_MAX_CONTEXT_TOKENS=128000
LLM_TEMPERATURE=0.1

# ── Context Budget (regex-vs-llm pre-filter) ──
CONTEXT_BUDGET_MAX_TOKENS=32000
PREFILTER_COMPRESSION_TARGET=0.05

# ── Slack Human Gate ──
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=
SLACK_APPROVAL_TTL_SECONDS=3600

# ── MCP Client ──
MCP_TRANSPORT=stdio
MCP_HEARTBEAT_INTERVAL_MS=30000
MCP_RETRY_MAX=3
MCP_RETRY_BACKOFF_BASE_MS=1000

# ── Masking ──
MASKING_TOKEN_PREFIX=MASKED_
MASKING_DICTIONARY_PERSIST=false
